{
  "id": "mailchimp",
  "name": "Mailchimp",
  "version": "0.1.0",
  "baseUrl": "https://{MAILCHIMP_DC}.api.mailchimp.com/3.0",
  "auth": {
    "type": "basic",
    "usernameEnv": "MAILCHIMP_USERNAME",
    "passwordEnv": "MAILCHIMP_API_KEY"
  },
  "tools": [
    {
      "name": "mailchimp_list_audiences",
      "description": "List one page of audiences.",
      "method": "GET",
      "path": "/lists",
      "readOnly": true,
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {
          "count": "count",
          "offset": "offset"
        },
        "body": {}
      },
      "sampleArguments": {
        "count": 10
      },
      "evidence": {
        "state": "documented",
        "providerLiveValidation": "not-run"
      },
      "provenance": [
        "https://us22.api.mailchimp.com/schema/3.0/Paths/Lists/Collection.json",
        "https://us22.api.mailchimp.com/schema/3.0/Paths/Lists/Members/Collection.json"
      ]
    },
    {
      "name": "mailchimp_list_members",
      "description": "List members in one authorized audience.",
      "method": "GET",
      "path": "/lists/{list_id}/members",
      "readOnly": true,
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "list_id": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "list_id"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [
          "list_id"
        ],
        "query": {
          "count": "count"
        },
        "body": {}
      },
      "sampleArguments": {
        "list_id": "REPLACE_WITH_AUDIENCE_ID",
        "count": 10
      },
      "evidence": {
        "state": "documented",
        "providerLiveValidation": "not-run"
      },
      "provenance": [
        "https://us22.api.mailchimp.com/schema/3.0/Paths/Lists/Collection.json",
        "https://us22.api.mailchimp.com/schema/3.0/Paths/Lists/Members/Collection.json"
      ]
    },
    {
      "name": "mailchimp_add_pending_member",
      "description": "Add a consenting subscriber with pending status, triggering Mailchimp double opt-in confirmation.",
      "method": "POST",
      "path": "/lists/{list_id}/members",
      "readOnly": false,
      "approvalRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "list_id": {
            "type": "string",
            "minLength": 1
          },
          "email_address": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "list_id",
          "email_address"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [
          "list_id"
        ],
        "query": {},
        "body": {
          "email_address": "email_address"
        }
      },
      "sampleArguments": {
        "list_id": "REPLACE_WITH_AUDIENCE_ID",
        "email_address": "sandbox@example.com"
      },
      "evidence": {
        "state": "documented",
        "providerLiveValidation": "not-run"
      },
      "body": {
        "status": "pending"
      },
      "provenance": [
        "https://us22.api.mailchimp.com/schema/3.0/Paths/Lists/Collection.json",
        "https://us22.api.mailchimp.com/schema/3.0/Paths/Lists/Members/Collection.json"
      ]
    }
  ],
  "workflow": {
    "name": "Mailchimp authorized workflow",
    "description": "Inspect audiences and their members before explicitly requesting double opt-in for a consenting subscriber.",
    "steps": [
      "mailchimp_list_audiences",
      "mailchimp_list_members",
      "mailchimp_add_pending_member"
